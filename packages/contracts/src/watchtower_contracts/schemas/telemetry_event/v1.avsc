{
  "type": "record",
  "name": "TelemetryEvent",
  "namespace": "io.watchtower.telemetry",
  "doc": "One reading from a truck's edge device, as accepted by the ingest gateway. Topics: telemetry.raw.v1, telemetry.clean.v1. Evolution: BACKWARD; only add optional fields with defaults.",
  "fields": [
    {"name": "event_id", "type": {"type": "string", "logicalType": "uuid"}, "doc": "UUIDv5 of device_id, boot_id and seq (ADR-0002)"},
    {"name": "schema_version", "type": "int"},
    {"name": "vehicle_id", "type": "string"},
    {"name": "device_id", "type": "string"},
    {"name": "boot_id", "type": "string", "doc": "Changes on every device reboot; seq restarts with it"},
    {"name": "seq", "type": "long", "doc": "Per-boot sequence number; gaps reveal loss"},
    {"name": "event_time", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "Device clock at measurement, UTC"},
    {"name": "ingest_time", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "Gateway clock at acceptance, UTC"},
    {
      "name": "position",
      "type": ["null", {
        "type": "record",
        "name": "Position",
        "fields": [
          {"name": "lat", "type": "double"},
          {"name": "lon", "type": "double"},
          {"name": "speed_kmh", "type": "double"},
          {"name": "heading_deg", "type": ["null", "double"], "default": null},
          {"name": "gps_fix", "type": {"type": "enum", "name": "GpsFix", "symbols": ["UNKNOWN", "NO_FIX", "FIX_2D", "FIX_3D"], "default": "UNKNOWN"}},
          {"name": "hdop", "type": ["null", "double"], "default": null}
        ]
      }],
      "default": null,
      "doc": "Null when the device has no GPS fix"
    },
    {
      "name": "reefer",
      "type": {
        "type": "record",
        "name": "Reefer",
        "fields": [
          {"name": "setpoint_c", "type": "double"},
          {"name": "supply_air_c", "type": ["null", "double"], "default": null, "doc": "Null on probe dropout"},
          {"name": "return_air_c", "type": ["null", "double"], "default": null, "doc": "Null on probe dropout"},
          {"name": "cargo_probe_c", "type": ["null", "double"], "default": null, "doc": "Null on probe dropout"},
          {"name": "compressor", "type": {"type": "enum", "name": "CompressorState", "symbols": ["UNKNOWN", "RUNNING", "OFF", "FAULT"], "default": "UNKNOWN"}},
          {"name": "fault_code", "type": ["null", "string"], "default": null},
          {"name": "defrost", "type": "boolean"},
          {"name": "power_source", "type": {"type": "enum", "name": "PowerSource", "symbols": ["UNKNOWN", "ENGINE", "GENSET", "SHORE", "BATTERY"], "default": "UNKNOWN"}},
          {"name": "door", "type": {"type": "enum", "name": "DoorState", "symbols": ["UNKNOWN", "OPEN", "CLOSED"], "default": "UNKNOWN"}}
        ]
      }
    },
    {
      "name": "vehicle",
      "type": {
        "type": "record",
        "name": "Vehicle",
        "fields": [
          {"name": "fuel_pct", "type": ["null", "double"], "default": null},
          {"name": "battery_v", "type": ["null", "double"], "default": null},
          {"name": "ambient_c", "type": ["null", "double"], "default": null}
        ]
      }
    },
    {
      "name": "link",
      "type": {
        "type": "record",
        "name": "Link",
        "fields": [
          {"name": "signal_dbm", "type": ["null", "int"], "default": null},
          {"name": "buffered", "type": "boolean", "doc": "True when replayed from the device buffer after an outage"}
        ]
      }
    }
  ]
}
